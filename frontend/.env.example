# Supabase Configuration
# Copy this file to .env and fill in your project credentials.
# Expo carrega automaticamente este arquivo no `expo start` / builds
# (variáveis com prefixo EXPO_PUBLIC_ ficam disponíveis em process.env).

EXPO_PUBLIC_SUPABASE_URL=
# Chave publishable (sb_publishable_…) ou anon JWT (eyJ…)
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Firebase Configuration
# Console: Project settings > Your apps > Web app config
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
