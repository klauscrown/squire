# Supabase — auth (e-mail/anônimo) + dados (PostgreSQL, Storage)
EXPO_PUBLIC_SUPABASE_URL=
# Chave publishable (sb_publishable_…) ou anon JWT (eyJ…)
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Firebase — login Google (OAuth via Firebase → sessão Supabase)
# Console Firebase: Project settings > Your apps > Web/Android config
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# OAuth 2.0 Web Client ID — Firebase Console > Authentication > Sign-in method > Google > Web SDK
# Também configure o mesmo Client ID/Secret em Supabase > Authentication > Providers > Google
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
