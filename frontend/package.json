{
  "name": "squire",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "start:clean": "expo start --dev-client -c",
    "android": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/android-build.ps1",
    "android:build": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/android-build.ps1 -FixCache",
    "android:clean-cache": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/clean-dev-cache.ps1",
    "e2e:android": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/e2e-android-smoke.ps1",
    "android:release": "expo run:android --variant release",
    "prebuild": "expo prebuild --platform android --clean",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo-google-fonts/cinzel": "^0.4.2",
